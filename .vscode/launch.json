{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Debug auth-service",
      "port": 9229,
      "address": "localhost",
      "restart": true,
      "sourceMaps": true,
      "localRoot": "${workspaceFolder}/services/auth-service",
      "remoteRoot": "/app"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Debug request-service",
      "port": 9230,
      "address": "localhost",
      "restart": true,
      "sourceMaps": true,
      "localRoot": "${workspaceFolder}/services/request-service",
      "remoteRoot": "/app"
    },
    {
      "name": "Debug donor-service (Go)",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 2345,
      "host": "127.0.0.1"
    },
    {
      "name": "Debug match-engine (Go)",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 2346,
      "host": "127.0.0.1"
    }
  ],
  "compounds": [
    {
      "name": "Debug All Services",
      "configurations": ["Debug auth-service", "Debug request-service", "Debug donor-service (Go)"]
    }
  ]
}
